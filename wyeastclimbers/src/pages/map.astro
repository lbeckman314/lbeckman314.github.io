---
import Base from "../layouts/Base.astro";
import RouteMap from "../components/RouteMap.astro";
---
<Base title="Route map" description="A schematic map of the Mount Hood routes climbed, pioneered and reopened by the Wy'east Climbers.">
  <div class="wrap">
    <p class="kicker">Map</p>
    <h1>The club's mountain</h1>
    <p class="lede">Where the Wy'easters climbed. Hover or tap a route to highlight it, and follow its link to the timeline. The story behind these climbs is told in <a href="/exhibits/routes">New Lines on Wy'east</a>.</p>
    <RouteMap />
  </div>
</Base>
