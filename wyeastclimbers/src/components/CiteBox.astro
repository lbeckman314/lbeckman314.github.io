---
interface Props { title: string }
const { title } = Astro.props;
const url = new URL(Astro.url.pathname, Astro.site).toString();
---
<aside class="cite" data-pagefind-ignore>
  <h2 class="kicker">Cite this page</h2>
  <p class="citation">“{title}.” <em>Wy'east Climbers: A Living History</em>. {url}. Accessed <span class="accessed">[date]</span>.</p>
  <button type="button" class="copy">Copy citation</button>
</aside>
<style>
  .cite { margin-top: 3rem; padding: 1rem 1.25rem; border: 1px solid var(--rule); border-radius: 6px; font: 0.88rem/1.5 var(--sans); }
  .citation { margin: 0 0 0.75rem; word-break: break-word; }
  .copy { font: 600 0.8rem/1 var(--sans); padding: 0.5em 0.8em; border: 1px solid var(--accent); color: var(--accent); background: transparent; border-radius: 4px; cursor: pointer; }
</style>
<script>
  const today = new Date().toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
  document.querySelectorAll<HTMLElement>(".cite").forEach((box) => {
    box.querySelector(".accessed")!.textContent = today;
    const btn = box.querySelector<HTMLButtonElement>(".copy")!;
    btn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(box.querySelector(".citation")!.textContent!.trim());
        btn.textContent = "Copied";
      } catch {
        btn.textContent = "Select the text above to copy";
      }
      setTimeout(() => (btn.textContent = "Copy citation"), 2000);
    });
  });
</script>
