---
interface Props { status: "sourced" | "conflicting" | "unverified" }
const { status } = Astro.props;
const label = { sourced: "Sourced", conflicting: "Sources disagree", unverified: "Needs a source" }[status];
const icon = { sourced: "✓", conflicting: "≠", unverified: "?" }[status];
---
<span data-pagefind-ignore class={`badge ${status}`} title={label}><span aria-hidden="true">{icon}</span>{label}</span>
