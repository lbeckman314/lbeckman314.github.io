---
import { getEntries, getEntry, render, type CollectionEntry } from "astro:content";
import Badge from "./Badge.astro";
import { categoryLabels } from "../lib";

interface Props { m: CollectionEntry<"milestones"> }
const { m } = Astro.props;
const { Content } = await render(m);
const people = await getEntries(m.data.people);
const sources = await getEntries(m.data.sources);
const exhibit = m.data.exhibit ? await getEntry(m.data.exhibit) : undefined;
const year = m.data.date && !m.data.undated ? m.data.date.getUTCFullYear() : undefined;
---
<li class="milestone" data-category={m.data.category} data-year={year}>
  <div class="when">{m.data.dateLabel ?? m.data.date?.toISOString().slice(0, 10)}</div>
  <div class="what">
    <div class="meta">
      <span class={`cat cat-${m.data.category}`}>{categoryLabels[m.data.category]}</span>
      <Badge status={m.data.status} />
    </div>
    <h3 id={m.id}><a href={`#${m.id}`}>{m.data.title}</a></h3>
    <div class="body"><Content /></div>
    {(people.length > 0 || exhibit) && (
      <p class="links">
        {people.length > 0 && (
          <span>People: {people.map((p, i) => <>{i > 0 && ", "}<a href={`/people/${p.id}`}>{p.data.name.replace(/ \(.*\)$/, "")}</a></>)}</span>
        )}
        {exhibit && <span>Exhibit: <a href={`/exhibits/${exhibit.id}`}>{exhibit.data.title}</a></span>}
      </p>
    )}
    {sources.length > 0 && (
      <details class="cites">
        <summary>{sources.length} source{sources.length > 1 ? "s" : ""}</summary>
        <ul>
          {sources.map((s) => <li>{s.data.url ? <a href={s.data.url} rel="noopener">{s.data.title}</a> : <cite>{s.data.title}</cite>}{s.data.publisher && ` — ${s.data.publisher}`}</li>)}
        </ul>
      </details>
    )}
  </div>
</li>
<style>
  .milestone { display: grid; grid-template-columns: 9.5rem 1fr; gap: 1.5rem; padding: 1.5rem 0; border-top: 1px solid var(--rule); position: relative; }
  .when { font: 600 0.95rem/1.3 var(--sans); color: var(--accent); padding-top: 0.15rem; }
  .meta { display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center; margin-bottom: 0.4rem; }
  .cat { font: 600 0.7rem/1 var(--sans); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-soft); }
  h3 { margin: 0 0 0.5rem; font-size: 1.3rem; scroll-margin-top: 4rem; }
  h3 a { color: inherit; text-decoration: none; }
  h3 a:hover { color: var(--accent); }
  .body { max-width: var(--measure); }
  .body :global(p) { margin-bottom: 0.7rem; }
  .links { font: 0.88rem/1.5 var(--sans); color: var(--ink-soft); display: flex; flex-wrap: wrap; gap: 0.25rem 1.25rem; margin: 0.25rem 0 0.5rem; }
  .cites { font: 0.85rem/1.5 var(--sans); color: var(--ink-soft); }
  .cites summary { cursor: pointer; width: fit-content; }
  .cites ul { margin: 0.4rem 0 0; padding-left: 1.1rem; }
  @media (max-width: 640px) {
    .milestone { grid-template-columns: 1fr; gap: 0.35rem; }
  }
</style>
