---
import { type CollectionEntry, getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import PostCard from "@components/PostCard.astro";
import DraftsToggle from "@components/DraftsToggle.astro";
import TagsToggle from "@components/TagsToggle.astro";
import PageSearch from "@components/PageSearch.astro";
import { BLOG } from "@consts";
import { shouldListPage } from "@lib/utils";
import { Icon } from "astro-icon/components";

const posts = (await getCollection("notes"))
  .filter(shouldListPage)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const tags = posts
  .flatMap((post) => post.data.tags ?? [])
  .filter((tag, index, self) => self.indexOf(tag) === index);

type Acc = {
  [year: string]: CollectionEntry<"notes">[];
};

const postsMap = posts.reduce((acc: Acc, post) => {
  const year = post.data.date.getUTCFullYear().toString();
  if (!acc[year]) {
    acc[year] = [];
  }
  acc[year].push(post);
  return acc;
}, {});

const years = Object.keys(postsMap).sort((a, b) => parseInt(b) - parseInt(a));
---

<Layout title={BLOG.TITLE} description={BLOG.DESCRIPTION} route="notes">
  <div class="page-head">
    <h1 class="page-title">Notes<Icon name="tabler:notes" /></h1>
  </div>

  <PageSearch placeholder="Search notes..." />

  <div class="filter-row">
    <TagsToggle />
    <DraftsToggle />
  </div>

  <div class="filter-row tag-filter-row">
    <button class="pill active" type="button" data-tag="" aria-pressed="true">
      all posts
    </button>
    {
      tags.map((tag) => (
        <button class="pill" type="button" data-tag={tag} aria-pressed="false">
          #{tag}
        </button>
      ))
    }
  </div>

  {
    years.map((year) => (
      <div data-search-group>
        <div class="year">{year}</div>
        <div class="card-list">
          {postsMap[year].map((post) => (
            <div
              data-search-text={[
                post.data.title,
                post.data.subtitle,
                post.data.date.toISOString(),
                post.data.description,
                post.data.series,
                ...(post.data.tags ?? []),
              ]
                .filter(Boolean)
                .join(" ")}
              data-tags={(post.data.tags ?? []).join(" ")}
            >
              <PostCard entry={post} />
            </div>
          ))}
        </div>
      </div>
    ))
  }
</Layout>
