---
import { type CollectionEntry, getCollection, render } from "astro:content";
import Layout from "@layouts/Layout.astro";
import FormattedDate from "@components/FormattedDate.astro";
import {
  shouldRenderPage,
  shouldListPage,
  iconForSocial,
  slugify,
  githubEditUrl,
} from "@lib/utils";
import TableOfContents from "@components/TableOfContents.astro";
import Aside from "@components/Aside.astro";

export async function getStaticPaths() {
  // Both draft and archived posts are built (so they're reachable by direct
  // URL) but excluded from listings - see shouldListPage.
  const posts = (await getCollection("notes"))
    .filter(shouldRenderPage)
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  return posts.map((post) => ({
    params: { slug: post.id },
    props: post,
  }));
}

type Props = CollectionEntry<"notes">;

const post = Astro.props;
const { Content, headings } = await render(post);
const tags = post.data.tags ?? [];
const socials = post.data.socials ?? [];
import { Icon } from "astro-icon/components";
---

<Layout
  title={post.data.title}
  description={post.data.description}
  route={`${post.collection}/${post.id}`}
  article={{
    title: post.data.title,
    publishedDate: post.data.date,
    updatedDate: post.data.updated,
    tags: post.data.tags,
  }}
>
  <a class="backlink" href="/notes">‹ Back to notes</a>

  <article class="post-grid">
    <aside class="post-aside">
      {headings.length > 0 && <TableOfContents headings={headings} />}
    </aside>

    <div class="post-main">
      <div class="article-head">
        {
        post.data.draft && (
          <div class="admonition admonition-warning">
            <p class="admonition-title">
              <Icon name="tabler:alert-triangle" />
              Draft Post 🚧
            </p>
          </div>
        )
      }
        <h1>{post.data.title}</h1>
        {post.data.subtitle && <p class="article-subtitle">{post.data.subtitle}</p>}
        <div class="article-meta">
          <span><FormattedDate date={post.data.date} /></span>
          {post.filePath && (
            <>
              <span class="sep">·</span>
              <a
                class="edit-github"
                href={githubEditUrl(post.filePath)}
                target="_blank"
                rel="noopener"
              >
                <Icon name="tabler:brand-github" />
                Edit on GitHub
              </a>
            </>
          )}
        </div>
        <div class="article-tags">
          {tags.map((tag) => <a href={`/notes?tags=${encodeURIComponent(tag)}`}>#{tag}</a>)}
          {
            socials.length > 0 && (
              <>
                {tags.length > 0 && (
                  <span class="repo" style="color:var(--dim)">
                    ·
                  </span>
                )}
                <span class="repo">Discuss on</span>
                {socials.toSorted().map((social) => (
                  <a
                    class="repo discuss-link"
                    href={social}
                    target="_blank"
                    rel="noopener"
                    aria-label="Discuss"
                  >
                    <span set:html={iconForSocial(social)} />
                  </a>
                ))}
              </>
            )
          }
        </div>
      </div>

      {
        post.data.series && (
          <div class="admonition admonition-note series-note">
            <p class="admonition-title">
              <Icon name="tabler:book" />
              Series
            </p>
            <p>
              <a href={`/notes/series/${slugify(post.data.series)}`}>
                {post.data.series}
              </a>
            </p>
          </div>
        )
      }

      <div class:list={["article", { "indent-paragraphs": post.data.indent }]}>
        <Content components={{ Aside }} />
      </div>
    </div>
  </article>
</Layout>
