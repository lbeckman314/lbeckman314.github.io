---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import ProjectCard from "@components/ProjectCard.astro";
import TagsToggle from "@components/TagsToggle.astro";
import PageSearch from "@components/PageSearch.astro";
import { PROJECTS } from "@consts";
import { withProjectsData } from "@lib/projects";
import { shouldListPage } from "@lib/utils";
import { Icon } from "astro-icon/components";

const projects = (await getCollection("projects"))
  .filter(shouldListPage)
const projectCards = (await withProjectsData(projects)).sort((a, b) =>
  a.data.title.localeCompare(b.data.title),
);

const professionalProjects = projectCards.filter(
  (p) => p.data.professional,
);
const personalProjects = projectCards.filter(
  (p) => !p.data.professional,
);

const tags = projectCards
  .flatMap((project) => project.data.tags)
  .filter((tag, index, self) => self.indexOf(tag) === index);
---

<Layout
  title={PROJECTS.TITLE}
  description={PROJECTS.DESCRIPTION}
  route="projects"
>
  <div class="page-head">
    <h1 class="page-title">Projects<Icon name="tabler:code" /></h1>
  </div>

  <PageSearch placeholder="Search projects..." />

  <div class="filter-row">
    <TagsToggle />
    <button
      class="pill sort-toggle active"
      type="button"
      data-sort="title"
      aria-pressed="true"
    >
      A→Z
    </button>
    <button
      class="pill sort-toggle"
      type="button"
      data-sort="updated"
      aria-pressed="false"
    >
      Recently updated
    </button>
  </div>

  <div class="filter-row tag-filter-row">
    <button class="pill active" type="button" data-tag="" aria-pressed="true">
      all projects
    </button>
    {
      tags.map((tag) => (
        <button class="pill" type="button" data-tag={tag} aria-pressed="false">
          #{tag}
        </button>
      ))
    }
  </div>

  {
    professionalProjects.length > 0 && (
      <div data-search-group>
        <h2 class="section-heading">Professional</h2>
        <div class="card-list">
          {professionalProjects.map((project) => (
            <div
              data-search-text={[
                project.data.title,
                project.data.subtitle,
                project.data.description,
                ...(project.data.tags ?? []),
              ]
                .filter(Boolean)
                .join(" ")}
              data-tags={(project.data.tags ?? []).join(" ")}
              data-title={project.data.title.toLowerCase()}
              data-updated={(
                project.data.updated ?? project.data.date
              )?.valueOf() ?? 0}
            >
              <ProjectCard entry={project.entry} data={project.data} />
            </div>
          ))}
        </div>
      </div>
    )
  }

  {
    personalProjects.length > 0 && (
      <div data-search-group>
        <h2 class="section-heading">Personal</h2>
        <div class="card-list">
          {personalProjects.map((project) => (
            <div
              data-search-text={[
                project.data.title,
                project.data.subtitle,
                project.data.description,
                ...(project.data.tags ?? []),
              ]
                .filter(Boolean)
                .join(" ")}
              data-tags={(project.data.tags ?? []).join(" ")}
              data-title={project.data.title.toLowerCase()}
              data-updated={(
                project.data.updated ?? project.data.date
              )?.valueOf() ?? 0}
            >
              <ProjectCard entry={project.entry} data={project.data} />
            </div>
          ))}
        </div>
      </div>
    )
  }
</Layout>

<script>
  const SORT_KEY = "ddb-project-sort";

  function bindProjectSort() {
    const buttons = Array.from(
      document.querySelectorAll<HTMLButtonElement>(".sort-toggle"),
    );
    const lists = Array.from(
      document.querySelectorAll<HTMLElement>("[data-search-group] .card-list"),
    );
    if (buttons.length === 0 || buttons[0].dataset.bound) return;
    for (const button of buttons) button.dataset.bound = "1";

    const applySort = (sort: string) => {
      for (const list of lists) {
        const cards = Array.from(list.children) as HTMLElement[];
        cards.sort((a, b) =>
          sort === "updated"
            ? Number(b.dataset.updated ?? 0) - Number(a.dataset.updated ?? 0)
            : (a.dataset.title ?? "").localeCompare(b.dataset.title ?? ""),
        );
        for (const card of cards) list.appendChild(card);
      }

      for (const button of buttons) {
        const active = button.dataset.sort === sort;
        button.classList.toggle("active", active);
        button.setAttribute("aria-pressed", String(active));
      }
      localStorage.setItem(SORT_KEY, sort);
    };

    for (const button of buttons) {
      button.addEventListener("click", () => applySort(button.dataset.sort ?? "title"));
    }

    applySort(localStorage.getItem(SORT_KEY) ?? "title");
  }

  bindProjectSort();
  document.addEventListener("astro:page-load", bindProjectSort);
</script>

<style>
  .section-heading {
    margin: 48px 0 18px;
    font-size: calc(13px * var(--fsm));
    font-weight: 600;
    color: var(--mut);
    text-transform: uppercase;
    letter-spacing: 0.14em;
  }
  .sort-row {
    align-items: center;
    margin-top: -14px;
  }
  .sort-label {
    font-family: var(--mono);
    font-size: calc(12.5px * var(--fsm));
    color: var(--dim);
  }
</style>
