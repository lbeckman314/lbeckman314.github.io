---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import ProjectCard from "@components/ProjectCard.astro";
import TagsToggle from "@components/TagsToggle.astro";
import PageSearch from "@components/PageSearch.astro";
import { PROJECTS } from "@consts";
import { withProjectsData } from "@lib/projects";
import { shouldListPage } from "@lib/utils";
import { Icon } from "astro-icon/components";

const projects = (await getCollection("projects"))
  .filter(shouldListPage)
const projectCards = await withProjectsData(projects);

const professionalProjects = projectCards.filter(
  (p) => p.data.professional,
);
const personalProjects = projectCards.filter(
  (p) => !p.data.professional,
);

const tags = projectCards
  .flatMap((project) => project.data.tags)
  .filter((tag, index, self) => self.indexOf(tag) === index);
---

<Layout
  title={PROJECTS.TITLE}
  description={PROJECTS.DESCRIPTION}
  route="projects"
>
  <div class="page-head">
    <h1 class="page-title">Projects<Icon name="tabler:code" /></h1>
  </div>

  <PageSearch placeholder="Search projects..." />

  <div class="filter-row">
    <TagsToggle />
  </div>

  <div class="filter-row tag-filter-row">
    <button class="pill active" type="button" data-tag="" aria-pressed="true">
      all projects
    </button>
    {
      tags.map((tag) => (
        <button class="pill" type="button" data-tag={tag} aria-pressed="false">
          #{tag}
        </button>
      ))
    }
  </div>

  {
    professionalProjects.length > 0 && (
      <div data-search-group>
        <h2 class="section-heading">Professional</h2>
        <div class="card-list">
          {professionalProjects.map((project) => (
            <div
              data-search-text={[
                project.data.title,
                project.data.subtitle,
                project.data.description,
                ...(project.data.tags ?? []),
              ]
                .filter(Boolean)
                .join(" ")}
              data-tags={(project.data.tags ?? []).join(" ")}
            >
              <ProjectCard entry={project.entry} data={project.data} />
            </div>
          ))}
        </div>
      </div>
    )
  }

  {
    personalProjects.length > 0 && (
      <div data-search-group>
        <h2 class="section-heading">Personal</h2>
        <div class="card-list">
          {personalProjects.map((project) => (
            <div
              data-search-text={[
                project.data.title,
                project.data.subtitle,
                project.data.description,
                ...(project.data.tags ?? []),
              ]
                .filter(Boolean)
                .join(" ")}
              data-tags={(project.data.tags ?? []).join(" ")}
            >
              <ProjectCard entry={project.entry} data={project.data} />
            </div>
          ))}
        </div>
      </div>
    )
  }
</Layout>

<style>
  .section-heading {
    margin: 48px 0 18px;
    font-size: calc(13px * var(--fsm));
    font-weight: 600;
    color: var(--mut);
    text-transform: uppercase;
    letter-spacing: 0.14em;
  }
</style>
