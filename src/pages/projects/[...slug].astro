---
// Projects no longer have their own detail page - old links here (and the
// /code/[...slug] redirect above them) go straight to the project's repo
// instead.
import { getCollection } from "astro:content";
import { shouldRenderPage } from "@lib/utils";
import { getPrimaryProjectLink, getProjectData } from "@lib/projects";

export async function getStaticPaths() {
  const projects = (await getCollection("projects")).filter(shouldRenderPage);
  return projects.map((project) => ({
    params: { slug: project.id },
    props: project,
  }));
}

const projectEntry = Astro.props;
const projectData = await getProjectData(projectEntry);
const href = getPrimaryProjectLink(projectEntry, projectData);

return Astro.redirect(href, 301);
---
