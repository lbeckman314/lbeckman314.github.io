---
// Projects no longer have their own detail page - old links here (and the
// /code/[...slug] redirect above them) go straight to the project's repo
// instead. (Not the site: a project's site can itself be a /projects/ path,
// which would redirect back here.)
import { getCollection } from "astro:content";
import { shouldRenderPage } from "@lib/utils";

export async function getStaticPaths() {
  const projects = (await getCollection("projects")).filter(shouldRenderPage);
  return projects.map((project) => ({
    params: { slug: project.id },
    props: project,
  }));
}

const projectEntry = Astro.props;

return Astro.redirect(projectEntry.data.repo, 301);
---
