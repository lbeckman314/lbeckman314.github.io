---
import Layout from "@layouts/Layout.astro";
import Resume from "@components/Resume.astro";
import { SITE } from "@consts";
import { Icon } from "astro-icon/components";
---

<Layout title="About me" description="All about me, Liam" route="about">
  <div class="page-head">
    <h1 class="page-title">About me</h1>
    <img id="smile" src="/assets/icon-smile.svg" alt="" width="100" height="100" />
  </div>

  <div class="prose">
    <div class="social-list">
      <a class="social-row" href="https://github.com/lbeckman314" target="_blank" rel="noopener">
        <span class="ic"><Icon name="tabler:brand-github" /></span>
        <span><span class="lbl">GitHub</span><br /><span class="handle">@lbeckman314</span></span>
      </a>
      <a class="social-row" href="https://www.linkedin.com/in/liam-beckman-ab3183a6" target="_blank" rel="noopener">
        <span class="ic"><Icon name="tabler:brand-linkedin" /></span>
        <span><span class="lbl">LinkedIn</span><br /><span class="handle">in/liambeckman</span></span>
      </a>
      <a class="social-row" href="https://github.com/lbeckman314/resume/releases/latest/download/resume.pdf" target="_blank" rel="noopener">
        <span class="ic"><Icon name="tabler:file-cv" /></span>
        <span><span class="lbl">Resume</span><br /><span class="handle">resume.pdf</span></span>
      </a>
      <a class="social-row" href="/rss.xml">
        <span class="ic"><Icon name="tabler:rss" /></span>
        <span><span class="lbl">RSS</span><br /><span class="handle">/rss.xml</span></span>
      </a>
      <a class="social-row email" href={SITE.EMAIL} aria-label="Email Drew">
        <span class="ic"><Icon name="tabler:mail" /></span>
        <span><span class="lbl">Email</span><br /><span class="handle email email-text">{SITE.EMAIL}</span></span>
      </a>
    </div>

    <hr />
    <Resume />
  </div>
</Layout>

<style is:global>
  .page-head {
    display: flex;
    align-items: center;
    gap: 1em;
  }
  .social-list {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin: 8px 0;
  }
  .social-row {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    padding: 10px 12px;
    border-radius: 10px;
    transition: background 0.15s;
  }
  .social-row:hover {
    background: var(--card-hover);
  }
  .social-row .ic {
    width: 34px;
    height: 34px;
    border-radius: 9px;
    background: var(--chip-bg);
    border: 1px solid var(--line);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--ink);
    flex: none;
  }
  .social-row .ic svg {
    width: 17px;
    height: 17px;
  }
  .social-row .lbl {
    font-size: calc(15px * var(--fsm));
    font-weight: 600;
    color: var(--accent-text);
  }
  .social-row:hover .lbl,
  .social-row:focus-visible .lbl {
    text-decoration: underline;
  }
  .social-row .handle {
    font-family: var(--mono);
    font-size: calc(12.5px * var(--fsm));
    color: var(--mut);
    white-space: nowrap;
  }
</style>
