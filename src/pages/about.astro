---
import Layout from "@layouts/Layout.astro";
import { SITE } from "@consts";
---

<Layout title="About me" description="All about me, Drew" route="about">
  <div class="page-head">
    <h1 class="page-title">About me</h1>
  </div>

  <div class="prose">
    <div class="social-list">
      <a
        class="social-row"
        href="https://github.com/lbeckman314"
        target="_blank"
        rel="noopener"
      >
        <span class="ic"
          ><svg viewBox="0 0 24 24" fill="currentColor"
            ><path
              d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48l-.01-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.53 2.36 1.09 2.94.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.02a9.6 9.6 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.38.2 2.4.1 2.65.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.69-4.57 4.94.36.31.68.92.68 1.85l-.01 2.75c0 .27.18.58.69.48A10 10 0 0 0 12 2Z"
            ></path></svg
          ></span
        >
        <span
          ><span class="lbl">GitHub</span><br /><span class="handle"
            >@lbeckman314</span
          ></span
        >
      </a>
      <a
        class="social-row"
        href="https://www.linkedin.com/in/liam-beckman-ab3183a6"
        target="_blank"
        rel="noopener"
      >
        <span class="ic"
          ><svg viewBox="0 0 24 24" fill="currentColor"
            ><path
              d="M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.36V9h3.41v1.56h.05c.47-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM7.12 20.45H3.55V9h3.57v11.45ZM22.22 0H1.77C.8 0 0 .77 0 1.73v20.54C0 23.23.8 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z"
            ></path></svg
          ></span
        >
        <span
          ><span class="lbl">LinkedIn</span><br /><span class="handle"
            >in/liambeckman</span
          ></span
        >
      </a>
      <a class="social-row" href="/rss.xml">
        <span class="ic"
          ><svg viewBox="0 0 24 24" fill="currentColor"
            ><path
              d="M4 11a9 9 0 0 1 9 9h2.5A11.5 11.5 0 0 0 4 8.5V11Zm0 4a5 5 0 0 1 5 5h2.5A7.5 7.5 0 0 0 4 12.5V15Zm1.5 5a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3Z"
            ></path></svg
          ></span
        >
        <span
          ><span class="lbl">RSS</span><br /><span class="handle">/rss.xml</span
          ></span
        >
      </a>
      <a class="social-row email" href={SITE.EMAIL} aria-label="Email Drew">
        <span class="ic"
          ><svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            ><rect x="3" y="5" width="18" height="14" rx="2"></rect><path
              d="m3 7 9 6 9-6"></path></svg
          ></span
        >
        <span
          ><span class="lbl">Email</span><br /><span
            class="handle email email-text">{SITE.EMAIL}</span
          ></span
        >
      </a>
    </div>
  </div>
</Layout>

<style is:global>
  .prose h2 {
    margin: 40px 0 14px;
    font-size: calc(22px * var(--fsm));
    font-weight: 700;
    color: var(--ink);
    letter-spacing: -0.01em;
  }
  .prose p {
    margin: 16px 0;
    font-size: calc(16.5px * var(--fsm));
    line-height: 1.7;
    color: var(--reading);
    text-wrap: pretty;
  }
  .prose a {
    color: var(--accent-text);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .social-list {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin: 8px 0;
  }
  .social-row {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    padding: 10px 12px;
    border-radius: 10px;
    transition: background 0.15s;
  }
  .social-row:hover {
    background: var(--card-hover);
  }
  .social-row .ic {
    width: 34px;
    height: 34px;
    border-radius: 9px;
    background: var(--chip-bg);
    border: 1px solid var(--line);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--ink);
    flex: none;
  }
  .social-row .ic svg {
    width: 17px;
    height: 17px;
  }
  .social-row .lbl {
    font-size: calc(15px * var(--fsm));
    font-weight: 600;
    color: var(--ink);
  }
  .social-row .handle {
    font-family: var(--mono);
    font-size: calc(12.5px * var(--fsm));
    color: var(--mut);
    white-space: nowrap;
  }
  .keyblock {
    margin: 14px 0 26px;
    background: var(--code-bg);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 16px 18px;
    overflow-x: auto;
    box-shadow: var(--shadow);
  }
  .keyblock pre {
    margin: 0;
    font-family: var(--mono);
    font-size: calc(12px * var(--fsm));
    line-height: 1.5;
    color: var(--code-ink);
    white-space: pre;
  }
  .keylabel {
    font-family: var(--mono);
    font-size: calc(12px * var(--fsm));
    color: var(--mut);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin: 22px 0 0;
  }
</style>

<script>
  function bindCopyKeys() {
    const buttons = document.querySelectorAll<HTMLButtonElement>(".copy-key");
    buttons.forEach((btn) => {
      if (btn.dataset.bound) {
        return;
      }
      btn.dataset.bound = "1";
      btn.addEventListener("click", async () => {
        const targetId = btn.dataset.target;
        if (!targetId) {
          return;
        }
        const target = document.getElementById(targetId);
        if (!target || target.textContent === null) {
          return;
        }
        try {
          await navigator.clipboard.writeText(target.textContent);
        } catch {
          return;
        }
        const original = btn.textContent;
        btn.textContent = "copied ✓";
        setTimeout(() => {
          btn.textContent = original;
        }, 1400);
      });
    });
  }

  document.addEventListener("astro:page-load", bindCopyKeys);
  bindCopyKeys();
</script>
