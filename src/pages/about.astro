---
import Layout from "@layouts/Layout.astro";
import { SITE } from "@consts";
import { Icon } from "astro-icon/components";
---

<Layout title="About me" description="All about me, Liam" route="about">
  <div class="page-head">
    <h1 class="page-title">About me</h1>
    <img id="smile" src="/assets/icon-smile.svg" alt="" />
  </div>

  <div class="prose">
    <div class="social-list">
      <!-- GitHub -->
      <a
        class="social-row"
        href="https://github.com/lbeckman314"
        target="_blank"
        rel="noopener"
      >
        <span class="ic"
          ><Icon name="tabler:brand-github" width={16} height={16} /></span
        >
        <span
          ><span class="lbl">GitHub</span><br /><span class="handle"
            >@lbeckman314</span
          ></span
        >
      </a>
      
      <!-- LinkedIn -->
      <a
        class="social-row"
        href="https://www.linkedin.com/in/liam-beckman-ab3183a6"
        target="_blank"
        rel="noopener"
      >
        <span class="ic"
          ><Icon name="tabler:brand-linkedin" width={16} height={16} /></span
        >
        <span
          ><span class="lbl">LinkedIn</span><br /><span class="handle"
            >in/liambeckman</span
          ></span
        >
      </a>
      
      <!-- Resume -->
      <a
        class="social-row"
        href="https://github.com/lbeckman314/resume/releases/latest/download/resume.pdf"
        target="_blank"
        rel="noopener"
      >
        <span class="ic"
          ><Icon name="tabler:file-cv" width={16} height={16} /></span
        >
        <span
          ><span class="lbl">Resume</span><br /><span class="handle"
            >resume.pdf</span
          ></span
        >
      </a>

      <!-- RSS -->
      <a class="social-row" href="/rss.xml">
        <span class="ic"
          ><Icon name="tabler:rss" width={16} height={16} /></span
        >
        <span
          ><span class="lbl">RSS</span><br /><span class="handle">/rss.xml</span
          ></span
        >
      </a>
      <a class="social-row email" href={SITE.EMAIL} aria-label="Email Drew">
        <span class="ic"
          ><Icon name="tabler:mail" width={16} height={16} /></span
        >
        <span
          ><span class="lbl">Email</span><br /><span
            class="handle email email-text">{SITE.EMAIL}</span
          ></span
        >
      </a>
    </div>
  </div>
</Layout>

<style is:global>
  .page-head {
    display: flex;
    align-items: center;
    gap: 1em;
  }
  .prose h2 {
    margin: 40px 0 14px;
    font-size: calc(22px * var(--fsm));
    font-weight: 700;
    color: var(--ink);
    letter-spacing: -0.01em;
  }
  .prose p {
    margin: 16px 0;
    font-size: calc(16.5px * var(--fsm));
    line-height: 1.7;
    color: var(--reading);
    text-wrap: pretty;
  }
  .prose a {
    color: var(--accent-text);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .social-list {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin: 8px 0;
  }
  .social-row {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    padding: 10px 12px;
    border-radius: 10px;
    transition: background 0.15s;
  }
  .social-row:hover {
    background: var(--card-hover);
  }
  .social-row .ic {
    width: 34px;
    height: 34px;
    border-radius: 9px;
    background: var(--chip-bg);
    border: 1px solid var(--line);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--ink);
    flex: none;
  }
  .social-row .ic svg {
    width: 17px;
    height: 17px;
  }
  .social-row .lbl {
    font-size: calc(15px * var(--fsm));
    font-weight: 600;
    color: var(--ink);
  }
  .social-row .handle {
    font-family: var(--mono);
    font-size: calc(12.5px * var(--fsm));
    color: var(--mut);
    white-space: nowrap;
  }
  .keyblock {
    margin: 14px 0 26px;
    background: var(--code-bg);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 16px 18px;
    overflow-x: auto;
    box-shadow: var(--shadow);
  }
  .keyblock pre {
    margin: 0;
    font-family: var(--mono);
    font-size: calc(12px * var(--fsm));
    line-height: 1.5;
    color: var(--code-ink);
    white-space: pre;
  }
  .keylabel {
    font-family: var(--mono);
    font-size: calc(12px * var(--fsm));
    color: var(--mut);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin: 22px 0 0;
  }
</style>

<script>
  function bindCopyKeys() {
    const buttons = document.querySelectorAll<HTMLButtonElement>(".copy-key");
    buttons.forEach((btn) => {
      if (btn.dataset.bound) {
        return;
      }
      btn.dataset.bound = "1";
      btn.addEventListener("click", async () => {
        const targetId = btn.dataset.target;
        if (!targetId) {
          return;
        }
        const target = document.getElementById(targetId);
        if (!target || target.textContent === null) {
          return;
        }
        try {
          await navigator.clipboard.writeText(target.textContent);
        } catch {
          return;
        }
        const original = btn.textContent;
        btn.textContent = "copied ✓";
        setTimeout(() => {
          btn.textContent = original;
        }, 1400);
      });
    });
  }

  document.addEventListener("astro:page-load", bindCopyKeys);
  bindCopyKeys();
</script>
