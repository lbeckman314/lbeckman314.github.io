---
import { type CollectionEntry, getCollection, render } from "astro:content";
import Layout from "@layouts/Layout.astro";
import FavoriteCard from "@components/FavoriteCard.astro";
import { Icon } from "astro-icon/components";

const favorites = await getCollection("favorites");

// Category comes from the entry's containing directory, e.g.
// "movies/children-of-men" -> "movies".
function categoryOf(entry: CollectionEntry<"favorites">) {
  return entry.id.split("/")[0];
}

// Poems read as prose, not cards - handled in their own section below.
const CATEGORY_ORDER = [
  "artwork",
  "books",
  "movies",
  "music",
  "podcasts",
];
const CATEGORY_LABELS: Record<string, string> = {
  artwork: "Artwork",
  books: "Books",
  movies: "Movies",
  music: "Music",
  podcasts: "Podcasts",
};

type Acc = Record<string, CollectionEntry<"favorites">[]>;

const cardFavorites = favorites.filter((entry) => categoryOf(entry) !== "poems");
const poems = favorites
  .filter((entry) => categoryOf(entry) === "poems")
  .sort((a, b) => a.data.title.localeCompare(b.data.title));

const favoritesByCategory = cardFavorites.reduce((acc: Acc, entry) => {
  const category = categoryOf(entry);
  (acc[category] ??= []).push(entry);
  return acc;
}, {});

for (const entries of Object.values(favoritesByCategory)) {
  entries.sort((a, b) => a.data.title.localeCompare(b.data.title));
}

const categories = Object.keys(favoritesByCategory).sort((a, b) => {
  const ai = CATEGORY_ORDER.indexOf(a);
  const bi = CATEGORY_ORDER.indexOf(b);
  if (ai === -1 && bi === -1) return a.localeCompare(b);
  if (ai === -1) return 1;
  if (bi === -1) return -1;
  return ai - bi;
});

const poemContents = await Promise.all(
  poems.map(async (entry) => ({ entry, Content: (await render(entry)).Content })),
);
---

<Layout title="Favorites" description="My favorite things" route="favorites" wide>
  <div class="page-head">
    <h1 class="page-title">Favorites<Icon name="tabler:heart" /></h1>
  </div>

  {
    categories.map((category) => (
      <>
        <div class="year">{CATEGORY_LABELS[category] ?? category}</div>
        <div class="favorites-grid">
          {favoritesByCategory[category].map((entry) => (
            <FavoriteCard entry={entry} />
          ))}
        </div>
      </>
    ))
  }

  {
    poemContents.length > 0 && (
      <>
        <div class="year">Poems</div>
        <div class="poems-list">
          {poemContents.map(({ entry, Content }) => (
            <div class="poem-entry">
              <h3 class="poem-title">
              <span class="min">※</span>
                {entry.data.src ? (
                  <a href={entry.data.src}>{entry.data.title}</a>
                ) : (
                  entry.data.title
                )}
              {entry.data.author && (
                <p class="poem-author">by {entry.data.author}</p>
              )}
              </h3>
              <div class="article poem-body">
                <Content />
              </div>
            </div>
          ))}
        </div>
      </>
    )
  }
</Layout>

<style is:global>
  .favorites-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    align-items: start;
    gap: 16px;
    margin-bottom: 8px;
  }
  @media (min-width: 900px) {
    .favorites-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .poems-list {
    display: flex;
    flex-direction: column;
    gap: 40px;
    max-width: 700px;
    margin-bottom: 8px;
  }
  .poem-title {
    margin: 0;
    font-size: calc(19px * var(--fsm));
    font-weight: 600;
    color: var(--ink);
    letter-spacing: -0.01em;
  }
  .poem-title a {
    color: var(--accent-text);
    text-decoration: none;
    text-underline-offset: 2px;
  }
  .poem-title a:hover,
  .poem-title a:focus-visible {
    text-decoration: underline;
  }
  .poem-title .min {
    color: var(--dim);
    margin-right: 6px;
  }
  .poem-author {
    margin: 4px 0 0;
    font-size: calc(14px * var(--fsm));
    color: var(--dim);
    font-style: italic;
  }
</style>
