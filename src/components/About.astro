---
const about = [
    "A stuck-up, half-witted, scruffy-looking nerf herder",
    "I’m a sleepy human with a dark history of secrets and intrigue.",
    "I'm a figment of your imagination. Is it cool if I kick it here for a little bit?",
    "I'm your standard average normal human person who engages in standard normal human activities.",
    "Hello, World!",
    "Pobody's nerfect...",
]

const lede = [
  "Of all the gin joints, in all the towns, in all the world, she walks into mine.",
  "Here's looking at you, kid.",
  "Play it, Sam. Play 'As Time Goes By.'",
  "We'll always have Paris.",
  "Round up the usual suspects.",
  "Louis, I think this is the beginning of a beautiful friendship.",
  "If that plane leaves the ground and you're not with him, you'll regret it. Maybe not today. Maybe not tomorrow, but soon and for the rest of your life.",
  "Look, I'm no good at being noble, but it doesn't take much to see that the problems of three little people don't amount to a hill of beans in this crazy world."
];

const pick = (items: string[]) =>
  items[Math.floor(Math.random() * items.length)];
---

<!-- Build-time picks are the no-JS fallback; the script below re-rolls them
     on every page load (including ClientRouter navigations). -->
<h1 data-about={JSON.stringify(about)}>
  {pick(about).toUpperCase()}
</h1>
<p class="lede" data-lede={JSON.stringify(lede)}>
  {pick(lede)}
</p>

<script>
  const pick = (items: string[]) =>
    items[Math.floor(Math.random() * items.length)];

  function rerollAbout() {
    const heading = document.querySelector<HTMLElement>("[data-about]");
    const lede = document.querySelector<HTMLElement>("[data-lede]");
    if (heading?.dataset.about) {
      heading.textContent = pick(JSON.parse(heading.dataset.about)).toUpperCase();
    }
    if (lede?.dataset.lede) {
      lede.textContent = pick(JSON.parse(lede.dataset.lede));
    }
  }

  document.addEventListener("astro:page-load", rerollAbout);
</script>
