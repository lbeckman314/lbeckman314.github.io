---
import PagefindConfig from "astro-pagefind/components/PagefindConfig.astro";

const quickLinks = [
  {
    href: "/",
    label: "Home",
    icon: `<path d="M5 12l-2 0l9 -9l9 9l-2 0"/><path d="M5 12v7a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2v-7"/><path d="M9 21v-6a2 2 0 0 1 2 -2h2a2 2 0 0 1 2 2v6"/>`,
  },
  {
    href: "/notes",
    label: "Notes",
    icon: `<path d="M5 3m0 2a2 2 0 0 1 2 -2h10a2 2 0 0 1 2 2v14a2 2 0 0 1 -2 2h-10a2 2 0 0 1 -2 -2z"/><path d="M9 7l6 0"/><path d="M9 11l6 0"/><path d="M9 15l4 0"/>`,
  },
  {
    href: "/projects",
    label: "Projects",
    icon: `<path d="M7 8l-4 4l4 4"/><path d="M17 8l4 4l-4 4"/><path d="M14 4l-4 16"/>`,
  },
  {
    href: "/about",
    label: "About",
    icon: `<path d="M8 7a4 4 0 1 0 8 0a4 4 0 0 0 -8 0"/><path d="M6 21v-2a4 4 0 0 1 4 -4h4a4 4 0 0 1 4 4v2"/>`,
  },
];
---

<PagefindConfig excerpt-length="15" />

<pagefind-modal reset-on-close>
  <pagefind-modal-body>
    <div class="sk-container">
      <div class="sk-main">
        <pagefind-input autofocus></pagefind-input>
        <pagefind-results show-images="false" show-sub-results
        ></pagefind-results>
      </div>
      <div class="sk-quick-links">
        <div class="sk-quick-links-title">Quick Links</div>
        <ul class="sk-quick-links-list">
          {
            quickLinks.map((link) => (
              <li>
                <a href={link.href}>
                  <svg
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    set:html={link.icon}
                  />
                  <span>{link.label}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </pagefind-modal-body>
</pagefind-modal>

<style is:global>
  :root {
    --pf-font: var(--sans);
    --pf-border-radius: 8px;
    --pf-modal-max-width: 760px;
    --pf-modal-backdrop: rgba(0, 0, 0, 0.5);
  }
  html[data-theme="light"] {
    --pf-text: #1c1a16;
    --pf-text-secondary: #2d2a24;
    --pf-background: #ffffff;
    --pf-border: rgba(20, 18, 12, 0.1);
    --pf-hover: rgba(20, 18, 12, 0.04);
  }
  html[data-theme="dark"] {
    --pf-text: #ececee;
    --pf-text-secondary: #cfcfd4;
    --pf-background: #161619;
    --pf-border: rgba(255, 255, 255, 0.08);
    --pf-hover: rgba(255, 255, 255, 0.05);
  }

  pagefind-modal::part(dialog) {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 14px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.4);
  }

  .sk-container {
    display: flex;
    width: 100%;
    max-height: 80vh;
    overflow: hidden;
  }
  .sk-main {
    flex: 1;
    min-width: 0;
    overflow: auto;
    padding: 14px 18px;
  }

  .sk-quick-links {
    flex: none;
    width: 190px;
    padding: 18px 14px;
    border-left: 1px solid var(--line);
    background: var(--chip-bg);
    overflow-y: auto;
  }
  .sk-quick-links-title {
    font-family: var(--mono);
    font-size: calc(11.5px * var(--fsm));
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--mut);
    margin-bottom: 10px;
  }
  .sk-quick-links-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .sk-quick-links-list a {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 8px;
    border-radius: 8px;
    color: var(--mut);
    text-decoration: none;
    font-size: calc(13.5px * var(--fsm));
    transition:
      background 0.15s,
      color 0.15s;
  }
  .sk-quick-links-list a:hover {
    background: var(--card-hover);
    color: var(--ink);
  }
  .sk-quick-links-list a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
    background: var(--card-hover);
    color: var(--ink);
  }
  .sk-quick-links-list svg {
    flex: none;
    width: 16px;
    height: 16px;
  }
  @media (max-width: 620px) {
    .sk-container {
      flex-direction: column;
      max-height: 85vh;
    }
    .sk-quick-links {
      width: auto;
      max-height: none;
      padding: 12px 18px 16px;
      border-left: 0;
      border-top: 1px solid var(--line);
    }
    .sk-quick-links-list {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }
    .sk-quick-links-list li {
      flex: none;
    }
    .sk-quick-links-list a {
      background: var(--card);
      border: 1px solid var(--line);
    }
  }
</style>
