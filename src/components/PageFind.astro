---
import Search from "astro-pagefind/components/Search";

const quickLinks = [
  {
    href: "/",
    label: "Home",
    icon: `<path d="M5 12l-2 0l9 -9l9 9l-2 0"/><path d="M5 12v7a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2v-7"/><path d="M9 21v-6a2 2 0 0 1 2 -2h2a2 2 0 0 1 2 2v6"/>`,
  },
  {
    href: "/notes",
    label: "Notes",
    icon: `<path d="M5 3m0 2a2 2 0 0 1 2 -2h10a2 2 0 0 1 2 2v14a2 2 0 0 1 -2 2h-10a2 2 0 0 1 -2 -2z"/><path d="M9 7l6 0"/><path d="M9 11l6 0"/><path d="M9 15l4 0"/>`,
  },
  {
    href: "/projects",
    label: "Projects",
    icon: `<path d="M7 8l-4 4l4 4"/><path d="M17 8l4 4l-4 4"/><path d="M14 4l-4 16"/>`,
  },
  {
    href: "/about",
    label: "About",
    icon: `<path d="M8 7a4 4 0 1 0 8 0a4 4 0 0 0 -8 0"/><path d="M6 21v-2a4 4 0 0 1 4 -4h4a4 4 0 0 1 4 4v2"/>`,
  },
];
---

<div transition:persist id="backdrop" class="pf-backdrop">
  <div id="pagefind-container" class="pf-container">
    <div class="pf-main">
      <Search
        id="search"
        className="pagefind-ui"
        uiOptions={{
          showImages: false,
          showSubResults: true,
          excerptLength: 15,
          resetStyles: false,
        }}
      />
      <div class="pf-hint">
        Press <kbd>Esc</kbd> or click anywhere to close
      </div>
    </div>
    <div class="pf-quick-links">
      <div class="pf-quick-links-title">Quick Links</div>
      <ul class="pf-quick-links-list">
        {
          quickLinks.map((link) => (
            <li>
              <a href={link.href}>
                <svg
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  set:html={link.icon}
                />
                <span>{link.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</div>

<script is:inline>
  const magnifyingGlass = document.getElementById("magnifying-glass");
  const backdrop = document.getElementById("backdrop");

  function openPagefind() {
    const search = document.getElementById("search")?.querySelector("input");
    backdrop?.classList.add("open");
    setTimeout(() => search?.focus(), 0);
  }

  function closePagefind() {
    const search = document.getElementById("search")?.querySelector("input");
    if (search) {
      search.value = "";
    }
    backdrop?.classList.remove("open");
  }

  magnifyingGlass?.addEventListener("click", openPagefind);

  document.addEventListener("keydown", (e) => {
    if (e.key === "/") {
      e.preventDefault();
      openPagefind();
    } else if ((e.metaKey || e.ctrlKey) && e.key === "k") {
      e.preventDefault();
      openPagefind();
    } else if (e.key === "Escape") {
      closePagefind();
    }
  });

  backdrop?.addEventListener("click", (event) => {
    if (!event.target.closest("#pagefind-container")) {
      closePagefind();
    }
  });
</script>

<style is:global>
  :root {
    --pagefind-ui-scale: 0.75;
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 8px;
    --pagefind-ui-font: var(--sans);
  }
  html[data-theme="light"] {
    --pagefind-ui-primary: #1c1a16;
    --pagefind-ui-text: #2d2a24;
    --pagefind-ui-background: #ffffff;
    --pagefind-ui-border: rgba(20, 18, 12, 0.1);
    --pagefind-ui-tag: rgba(20, 18, 12, 0.04);
  }
  html[data-theme="dark"] {
    --pagefind-ui-primary: #ececee;
    --pagefind-ui-text: #cfcfd4;
    --pagefind-ui-background: #161619;
    --pagefind-ui-border: rgba(255, 255, 255, 0.08);
    --pagefind-ui-tag: rgba(255, 255, 255, 0.05);
  }

  .pf-backdrop {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 50;
    justify-content: center;
    align-items: flex-start;
    padding: 8vh 24px 24px;
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(4px);
  }
  .pf-backdrop.open {
    display: flex;
  }
  .pf-container {
    display: flex;
    width: 100%;
    max-width: 760px;
    max-height: 80vh;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 14px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.4);
    overflow: hidden;
  }
  .pf-main {
    flex: 1;
    min-width: 0;
    overflow: auto;
    padding: 14px 18px;
  }
  .pf-hint {
    margin-top: 10px;
    text-align: right;
    font-family: var(--mono);
    font-size: calc(12px * var(--fsm));
    color: var(--dim);
  }
  .pf-hint kbd {
    font-family: var(--mono);
    border: 1px solid var(--line);
    border-radius: 5px;
    padding: 1px 5px;
    background: var(--chip-bg);
  }

  .pf-quick-links {
    flex: none;
    width: 190px;
    padding: 18px 14px;
    border-left: 1px solid var(--line);
    background: var(--chip-bg);
    overflow-y: auto;
  }
  .pf-quick-links-title {
    font-family: var(--mono);
    font-size: calc(11.5px * var(--fsm));
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--mut);
    margin-bottom: 10px;
  }
  .pf-quick-links-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .pf-quick-links-list a {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 8px;
    border-radius: 8px;
    color: var(--mut);
    text-decoration: none;
    font-size: calc(13.5px * var(--fsm));
    transition:
      background 0.15s,
      color 0.15s;
  }
  .pf-quick-links-list a:hover {
    background: var(--card-hover);
    color: var(--ink);
  }
  .pf-quick-links-list a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
    background: var(--card-hover);
    color: var(--ink);
  }
  .pf-quick-links-list svg {
    flex: none;
    width: 16px;
    height: 16px;
  }
  @media (max-width: 620px) {
    .pf-quick-links {
      display: none;
    }
  }

  #search input {
    font-weight: normal;
  }
  #search p {
    font-weight: normal;
  }
  #search .pagefind-ui__result-title {
    font-weight: 600;
  }
  #search .pagefind-ui__result-title .pagefind-ui__result-link {
    color: var(--accent-text);
  }
  #search .pagefind-ui__result-title .pagefind-ui__result-link:hover {
    text-decoration: underline;
  }
  #search .pagefind-ui__result-nested .pagefind-ui__result-link {
    color: var(--ink);
  }
  #search .pagefind-ui__result-nested .pagefind-ui__result-link:hover {
    color: var(--accent-text);
  }
  #search mark {
    background: color-mix(in srgb, var(--accent) 35%, transparent);
    color: var(--ink);
    font-weight: 600;
    border-radius: 3px;
  }
  #search .pagefind-ui__message {
    padding: 0;
    padding-bottom: 0.75rem;
  }
</style>
