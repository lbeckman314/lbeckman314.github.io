---
import { Icon } from "astro-icon/components";

type Props = { placeholder?: string };
const { placeholder = "Search..." } = Astro.props;
---

<div class="page-search">
  <Icon name="tabler:search" />
  <input
    type="search"
    class="page-search-input"
    placeholder={placeholder}
    aria-label={placeholder}
  />
</div>

<script>
  function normalize(text: string) {
    return text.trim().toLowerCase();
  }

  function bindPageSearch() {
    const input = document.querySelector<HTMLInputElement>(".page-search-input");
    const tagButtons = Array.from(
      document.querySelectorAll<HTMLButtonElement>(".tag-filter-row [data-tag]"),
    );
    if (!input || input.dataset.bound) return;
    input.dataset.bound = "1";

    const groups = Array.from(document.querySelectorAll<HTMLElement>("[data-search-group]"));
    const selectedTags = new Set<string>();

    const syncURL = () => {
      const url = new URL(window.location.href);
      if (selectedTags.size > 0) {
        url.searchParams.set("tags", Array.from(selectedTags).join(","));
      } else {
        url.searchParams.delete("tags");
      }
      const query = input.value.trim();
      if (query) {
        url.searchParams.set("q", query);
      } else {
        url.searchParams.delete("q");
      }
      window.history.replaceState(window.history.state, "", url);
    };

    const syncPillState = () => {
      for (const btn of tagButtons) {
        const tag = btn.dataset.tag ?? "";
        const isAll = tag === "";
        const active = isAll ? selectedTags.size === 0 : selectedTags.has(tag);
        btn.classList.toggle("active", active);
        btn.setAttribute("aria-pressed", String(active));
      }
    };

    const filter = () => {
      const query = normalize(input.value);

      for (const group of groups) {
        const cards = Array.from(
          group.querySelectorAll<HTMLElement>("[data-search-text]"),
        );
        let visibleInGroup = 0;

        for (const card of cards) {
          const haystack = normalize(card.dataset.searchText ?? "");
          const matchesQuery = query === "" || haystack.includes(query);

          const cardTags = (card.dataset.tags ?? "").split(" ").filter(Boolean);
          const matchesTags =
            selectedTags.size === 0 ||
            cardTags.some((tag) => selectedTags.has(tag));

          const match = matchesQuery && matchesTags;
          card.hidden = !match;
          if (match) visibleInGroup++;
        }

        group.hidden = visibleInGroup === 0;
      }

      syncPillState();
      syncURL();
    };

    const toggleTag = (tag: string) => {
      if (tag === "") {
        selectedTags.clear();
      } else if (selectedTags.has(tag)) {
        selectedTags.delete(tag);
      } else {
        selectedTags.add(tag);
      }
      filter();
    };

    for (const btn of tagButtons) {
      btn.addEventListener("click", () => toggleTag(btn.dataset.tag ?? ""));
    }

    input.addEventListener("input", filter);

    const params = new URLSearchParams(window.location.search);
    const initialTags = params.get("tags");
    if (initialTags) {
      for (const tag of initialTags.split(",")) {
        if (tag) selectedTags.add(tag);
      }
    }
    const initialQuery = params.get("q");
    if (initialQuery) {
      input.value = initialQuery;
    }

    window.addEventListener("popstate", () => {
      const p = new URLSearchParams(window.location.search);
      selectedTags.clear();
      for (const tag of (p.get("tags") ?? "").split(",")) {
        if (tag) selectedTags.add(tag);
      }
      input.value = p.get("q") ?? "";
      filter();
    });

    filter();
  }

  bindPageSearch();
  document.addEventListener("astro:page-load", bindPageSearch);
</script>

<style>
  .page-search {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 26px 0 14px;
    padding: 10px 14px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--chip-bg);
    color: var(--mut);
    transition: border-color 0.15s;
  }
  .page-search:focus-within {
    border-color: var(--accent);
    color: var(--ink);
  }
  .page-search svg {
    flex: none;
    width: 16px;
    height: 16px;
  }
  .page-search-input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: transparent;
    color: var(--ink);
    font-size: calc(14.5px * var(--fsm));
    font-family: inherit;
  }
  .page-search-input:focus {
    outline: none;
  }
  .page-search-input::placeholder {
    color: var(--mut);
  }
  /* Remove native search-input decorations (clear-x, magnifier) so our own
     icon and layout are the only chrome shown. */
  .page-search-input::-webkit-search-decoration,
  .page-search-input::-webkit-search-cancel-button,
  .page-search-input::-webkit-search-results-button,
  .page-search-input::-webkit-search-results-decoration {
    -webkit-appearance: none;
  }
</style>
