---
// Hardcover GraphQL API
const HARDCOVER_ENDPOINT = 'https://api.hardcover.app/v1/graphql';
const HARDCOVER_TOKEN = import.meta.env.HARDCOVER_TOKEN;

type Book = {
  title: string;
  author: string;
  link: string;
  cover: string;
  shelf: number;
  started: string;
  finished: string;
};

// Hardcover status_id: 1 = Want to Read, 2 = Currently Reading, 3 = Read
const SHELVES = [
  { id: 2, label: 'Reading' },
  { id: 3, label: 'Read' },
  { id: 1, label: 'Want to Read' },
];

type HardcoverUserBook = {
  status_id: number;
  first_started_reading_date: string | null;
  last_read_date: string | null;
  book: {
    slug: string | null;
    title: string | null;
    image: { url: string | null } | null;
    contributions: { author: { name: string | null } | null }[];
  } | null;
};

// Format a Hardcover date (ISO "2026-04-01") as "Apr 2026".
const formatMonthYear = (raw: string) => {
  if (!raw) return '';
  const d = new Date(raw);
  return isNaN(d.getTime())
    ? ''
    : d.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
};

const QUERY = `
  query CurrentlyReading {
    me {
      user_books {
        status_id
        first_started_reading_date
        last_read_date
        book {
          slug
          title
          image { url }
          contributions { author { name } }
        }
      }
    }
  }
`;

let books: Book[] = [];

if (!HARDCOVER_TOKEN) {
  console.warn('Books.astro: HARDCOVER_TOKEN is not set — skipping fetch.');
} else {
  try {
    const res = await fetch(HARDCOVER_ENDPOINT, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        Authorization: HARDCOVER_TOKEN.startsWith('Bearer ')
          ? HARDCOVER_TOKEN
          : `Bearer ${HARDCOVER_TOKEN}`,
      },
      body: JSON.stringify({ query: QUERY }),
    });

    const json = await res.json();

    if (json.errors) {
      console.error('Books.astro: Hardcover API errors', json.errors);
    }

    const userBooks: HardcoverUserBook[] = json.data?.me?.[0]?.user_books ?? [];

    books = userBooks
      .filter((ub) => ub.book && SHELVES.some((s) => s.id === ub.status_id))
      .map((ub) => ({
        title: ub.book!.title ?? '',
        author: ub.book!.contributions?.[0]?.author?.name ?? '',
        link: ub.book!.slug ? `https://hardcover.app/books/${ub.book!.slug}` : '',
        cover: ub.book!.image?.url ?? '',
        shelf: ub.status_id,
        started: formatMonthYear(ub.first_started_reading_date ?? ''),
        finished: formatMonthYear(ub.last_read_date ?? ''),
      }));
  } catch (e) {
    console.error('Books.astro: failed to fetch from Hardcover', e);
  }
}

---

{SHELVES.map(shelf => {
  const shelfBooks = books.filter(b => b.shelf === shelf.id);

  return shelfBooks.length > 0 && (
    <div class="shelf-section" data-carousel-shell>
      <div class="shelf-header">
        <h2>{shelf.label}</h2>
        {shelfBooks.length > 1 && (
          <button
            type="button"
            class="expand-button"
            data-expand-toggle
            aria-expanded="false"
          >
            <span class="expand-label">Expand</span>
          </button>
        )}
      </div>

      <div class="carousel-viewport">
        <div class="reading-list" data-carousel-track>
          {shelfBooks.map((book, i) => (
            <a class="reading-item" href={book.link} style={`--i: ${i}`}>
              {book.cover && (
                <img src={book.cover} alt={`Cover of ${book.title}`} />
              )}

              <div class="reading-meta">
                <span class="reading-title">{book.title}</span>
                <span class="reading-author">{book.author}</span>
                {book.started && (
                  <span class="reading-date">Started {book.started}</span>
                )}
                {book.finished && (
                  <span class="reading-date">Finished {book.finished}</span>
                )}
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>
  );
})}

<style>
  .shelf-section {
    margin: 2rem 0;
  }

  .shelf-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 0.8rem;
  }

  .expand-button {
    background: none;
    border: 1px solid #545454;
    border-radius: 999px;
    color: var(--theme-text);
    cursor: pointer;
    font: inherit;
    font-size: 0.85rem;
    padding: 0.35rem 0.8rem;
    white-space: nowrap;
    flex-shrink: 0;
    transition: background 0.2s;
  }

  .expand-button:hover {
    background: rgba(128, 128, 128, 0.15);
  }

  .carousel-viewport {
    overflow-x: auto;
    padding-bottom: 0.4rem;
    /* Snap scrolling */
    scroll-snap-type: x mandatory;
    /* Hide scrollbar: Firefox */
    scrollbar-width: none;
    /* Hide scrollbar: IE/Edge */
    -ms-overflow-style: none;
    /* Smoother programmatic/drag scroll */
    scroll-behavior: smooth;
  }

  /* Expanded: stop scrolling horizontally and lay books out in a grid. */
  .shelf-section.is-expanded .carousel-viewport {
    overflow-x: visible;
    scroll-snap-type: none;
  }

  .shelf-section.is-expanded .reading-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    width: auto;
    padding-right: 0;
  }

  .shelf-section.is-expanded .reading-item {
    cursor: pointer;
    max-width: none;
  }

  /* Per-card entrance animation, staggered via --i set in JS. */
  @keyframes book-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .shelf-section.is-animating .reading-item {
    animation: book-in 0.35s ease both;
    animation-delay: calc(var(--i, 0) * 0.035s);
  }

  @media (prefers-reduced-motion: reduce) {
    .shelf-section.is-animating .reading-item {
      animation: none;
    }
  }

  /* Hide scrollbar: Chrome/Safari */
  .carousel-viewport::-webkit-scrollbar {
    display: none;
  }

  /* While dragging, snap off so motion tracks the pointer 1:1 */
  .carousel-viewport.is-dragging {
    scroll-snap-type: none;
    scroll-behavior: auto;
    cursor: grabbing;
    user-select: none;
  }

  .reading-list {
    display: flex;
    gap: 1.2rem;
    width: max-content;
    padding-right: 0.5rem;
  }

  .reading-item {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    border: 1px solid #545454;
    border-radius: 6px;
    padding: 2em;
    transition: box-shadow 0.2s;
    max-width: 320px;
    min-width: 220px;
    flex-direction: column;
    flex: 0 0 auto;
    scroll-snap-align: start;
    cursor: grab;
  }

  .reading-item:hover {
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12);
    text-decoration: none;
  }

  .reading-item img {
    width: 12em;
    /* Fixed box so every cover occupies the same vertical space and the
       text below lines up across cards, regardless of cover dimensions. */
    height: 16em;
    object-fit: contain;
    border-radius: 3px;
    flex-shrink: 0;
  }

  .reading-meta {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    /* Push meta to the same baseline even when a card has no cover image. */
    margin-top: auto;
    align-self: stretch;
    text-align: left;
  }

  .reading-title {
    font-weight: 600;
    color: var(--theme-text);
    font-size: 0.95rem;
    line-height: 1.3;
  }

  .reading-author {
    color: #666;
    font-size: 0.85rem;
  }

  .reading-date {
    color: #888;
    font-size: 0.78rem;
    margin-top: 0.15rem;
  }
</style>

<script>
  // Drag-to-scroll for each book carousel. Touch swipe works natively via
  // overflow-x; this adds mouse click-and-drag panning on top.
  function initCarousels() {
    const viewports =
      document.querySelectorAll<HTMLElement>('.carousel-viewport');

    viewports.forEach((viewport) => {
      // Avoid attaching listeners twice on re-init.
      if (viewport.dataset.carouselReady) return;
      viewport.dataset.carouselReady = 'true';

      let isDown = false;
      let startX = 0;
      let startScroll = 0;
      let moved = false;

      const onPointerDown = (e: PointerEvent) => {
        // Only react to primary (left) button / touch / pen.
        if (e.button !== 0) return;
        isDown = true;
        moved = false;
        startX = e.clientX;
        startScroll = viewport.scrollLeft;
        viewport.classList.add('is-dragging');
      };

      const onPointerMove = (e: PointerEvent) => {
        if (!isDown) return;
        const dx = e.clientX - startX;
        if (Math.abs(dx) > 4) moved = true;
        viewport.scrollLeft = startScroll - dx;
      };

      const endDrag = () => {
        if (!isDown) return;
        isDown = false;
        viewport.classList.remove('is-dragging');
      };

      viewport.addEventListener('pointerdown', onPointerDown);
      viewport.addEventListener('pointermove', onPointerMove);
      viewport.addEventListener('pointerup', endDrag);
      viewport.addEventListener('pointerleave', endDrag);
      viewport.addEventListener('pointercancel', endDrag);

      // Swallow the click that fires after a drag so we don't navigate
      // to a book page when the user was just panning.
      viewport.addEventListener(
        'click',
        (e) => {
          if (moved) {
            e.preventDefault();
            e.stopPropagation();
          }
        },
        true
      );

      // Don't let the browser start a native image/link drag mid-pan.
      viewport.addEventListener('dragstart', (e) => e.preventDefault());
    });
  }

  // Expand / collapse: toggles the shelf between a horizontal carousel and a
  // wrapped grid that reveals every book below the viewport.
  function initExpandToggles() {
    const buttons =
      document.querySelectorAll<HTMLButtonElement>('[data-expand-toggle]');

    buttons.forEach((button) => {
      if (button.dataset.expandReady) return;
      button.dataset.expandReady = 'true';

      const shell = button.closest<HTMLElement>('[data-carousel-shell]');
      const label = button.querySelector<HTMLElement>('.expand-label');
      const viewport = shell?.querySelector<HTMLElement>('.carousel-viewport');
      if (!shell || !viewport) return;

      const reduceMotion = window.matchMedia(
        '(prefers-reduced-motion: reduce)'
      ).matches;

      button.addEventListener('click', () => {
        // Measure the current height before the layout changes.
        const startHeight = viewport.getBoundingClientRect().height;

        const expanded = shell.classList.toggle('is-expanded');
        button.setAttribute('aria-expanded', String(expanded));
        if (label) label.textContent = expanded ? 'Collapse' : 'Expand';

        if (reduceMotion) return;

        // Measure the target height after the class flip (grid vs. row).
        const endHeight = viewport.getBoundingClientRect().height;

        // Re-trigger the staggered per-card entrance.
        shell.classList.remove('is-animating');
        void shell.offsetWidth; // force reflow so the animation restarts
        shell.classList.add('is-animating');

        // Animate the container height from old to new, clipping overflow
        // so grid rows don't spill out while the height is mid-transition.
        const prevOverflowX = viewport.style.overflowX;
        viewport.style.overflow = 'hidden';
        const anim = viewport.animate(
          [{ height: `${startHeight}px` }, { height: `${endHeight}px` }],
          { duration: 350, easing: 'ease' }
        );
        anim.onfinish = () => {
          shell.classList.remove('is-animating');
          // Restore stylesheet-driven overflow (collapsed: auto / expanded: visible).
          viewport.style.overflow = '';
          viewport.style.overflowX = prevOverflowX;
        };
      });
    });
  }

  function init() {
    initCarousels();
    initExpandToggles();
  }

  init();
  // Re-init after Astro view transitions / client-side navigation.
  document.addEventListener('astro:page-load', init);
</script>
