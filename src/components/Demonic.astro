---
// A live terminal connected to the demonic server, via demonic-web's
// <demonic-terminal> element. It connects only when started (or scrolled
// into view with autostart="visible"), and disconnects when navigating away.
interface Props {
  // Command typed at the prompt when the terminal starts.
  command?: string;
  // Commands shown as buttons below the terminal.
  examples?: string[];
  // WebSocket address of the demonic server.
  url?: string;
  // When to connect: "click" (start button), "visible" or "load".
  autostart?: "click" | "visible" | "load";
  // Height of the terminal screen, e.g. "30em".
  height?: string;
}

const {
  command = "fortune | cowsay | lolcat",
  examples = ["pokeductor", "pipes.sh", "fortune | cowsay | lolcat", "cmatrix"],
  url = "wss://demonic.liambeckman.com",
  autostart = "click",
  height,
} = Astro.props;
---

<div class="demonic">
  <demonic-terminal
    url={url}
    command={command}
    examples={JSON.stringify(examples)}
    theme="auto"
    autostart={autostart}
    style={height ? `--demonic-height: ${height}` : undefined}
  ></demonic-terminal>
  <div class="demonic-links">
    <a href="https://github.com/lbeckman314/demonic">Source Code</a>
  </div>
</div>

<script>
  import "demonic-web";
</script>

<style>
  .demonic {
    margin: 1.5em 0;
  }

  .demonic demonic-terminal {
    --demonic-font-family: var(--mono, monospace);
  }

  .demonic-links {
    margin-top: 0.5em;
    text-align: right;
    font-size: smaller;
  }
</style>
