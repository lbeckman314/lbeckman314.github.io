---
import type { CollectionEntry } from "astro:content";
import Card from "@components/Card.astro";
import FormattedDate from "@components/FormattedDate.astro";
import RepoStars from "@components/RepoStars.astro";
import ProjectLinks from "@components/ProjectLinks.astro";
import { getProjectData, getProjectLinks, type ProjectData } from "@lib/projects";

type Props = { entry: CollectionEntry<"projects">; data?: ProjectData };

const { entry, data: projectData = await getProjectData(entry) } = Astro.props;
const tags = projectData.tags;
const links = getProjectLinks(entry, projectData);
const href = `/projects/${entry.id}`;
---

<Card as="div" class="project-card">
  <a
    slot="stretch-link"
    class="card-stretch"
    href={href}
    aria-label={`View ${projectData.title}`}
  />
  <Fragment slot="title">
    <div class="project-card-title-row">
      <span class="proj-dot"></span>
      <h3 class="card-title project-card-title">{projectData.title}</h3>
      <span class="chev" aria-hidden="true">›</span>
    </div>
    {projectData.subtitle && (
      <p class="card-sub">{projectData.subtitle}</p>
    )}
  </Fragment>
  {
    projectData.description && (
      <p slot="description" class="card-sub">
        {projectData.description}
      </p>
    )
  }
  <Fragment slot="chevron" />
  <Fragment slot="foot">
    {
      tags.length > 0 && (
        <span class="tags">
          {tags.map((tag) => (
            <span class="tag">#{tag}</span>
          ))}
        </span>
      )
    }
    <span class="card-demo">
      <ProjectLinks links={links} />
    </span>
    <span class="spacer"></span>
    <RepoStars repoURL={entry.data.repoURL} />
  </Fragment>
</Card>

<style is:global>
  .card.project-card {
    align-items: flex-start;
  }
  .project-card-title-row {
    display: flex;
    align-items: center;
    gap: 9px;
    margin-bottom: 12px;
  }
  .project-card-title-row:last-child {
    margin-bottom: 0;
  }
  .project-card-title {
    margin: 0;
    flex: 1;
    min-width: 0;
    font-family: var(--mono);
    font-size: calc(16px * var(--fsm));
  }
  .project-card-title-row .chev {
    color: var(--dim);
    font-size: calc(20px * var(--fsm));
    flex: none;
    transition:
      transform 0.15s,
      color 0.15s;
  }
  .card.project-card:hover .chev {
    transform: translateX(3px);
    color: var(--accent-text);
  }
  .proj-dot {
    width: 8px;
    height: 8px;
    border-radius: 2px;
    background: var(--accent);
    flex: none;
  }
  .card-demo {
    position: relative;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
</style>
