---
import type { CollectionEntry } from "astro:content";
import FormattedDate from "@components/FormattedDate.astro";
import MetaStats from "@components/MetaStats.astro";

type Props = { entry: CollectionEntry<"notes"> };

const { entry } = Astro.props;
const tags = entry.data.tags ?? [];
---

<a class="card" href={`/notes/${entry.slug}`}>
  <div class="body">
    <h3 class="card-title">{entry.data.title}</h3>
    <p class="card-sub">{entry.data.description}</p>
    <div class="card-foot">
      <span class="tags">
        {tags.map((tag) => <span class="tag">#{tag}</span>)}
      </span>
      <span class="spacer"></span>
      <span class="meta-bit"><FormattedDate date={entry.data.date} /></span>
      <MetaStats slug={`blog/${entry.slug}`} />
    </div>
  </div>
  <span class="chev">›</span>
</a>
